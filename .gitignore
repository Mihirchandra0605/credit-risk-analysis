# ==========================================
# Python
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
venv/
.venv/
env/
ENV/

# Python packaging
build/
dist/
*.egg-info/
.eggs/

# ==========================================
# Jupyter
# ==========================================
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# ==========================================
# Data files
# Do not commit large raw or processed datasets
# ==========================================
data/raw/*
!data/raw/.gitkeep

data/processed/*
!data/processed/.gitkeep

# ==========================================
# Model artifacts
# Regenerate locally by running the notebooks
# ==========================================
models/*.joblib
models/*.pkl
models/*.pickle
!models/.gitkeep

# ==========================================
# Environment variables and secrets
# ==========================================
.env
.env.*
!.env.example

# ==========================================
# Logs and temporary files
# ==========================================
*.log
*.tmp
*.bak
*.swp

# ==========================================
# Operating system
# ==========================================
.DS_Store
Thumbs.db
desktop.ini

# ==========================================
# Editor settings
# ==========================================
.vscode/
.idea/